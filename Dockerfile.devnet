FROM rust:1.85.0 AS chef
RUN curl -L --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash
RUN cargo binstall -y cargo-chef wild-linker
RUN apt-get update && apt-get install -y \
    clang \
    cmake \
    make \
    g++ \
    pkg-config \
    libssl-dev \
    libuv1-dev \
    git \
    && rm -rf /var/lib/apt/lists/*
# Install DataStax C++ driver for Cassandra
RUN git clone --depth 1 --branch 2.16.2 https://github.com/datastax/cpp-driver.git /tmp/cpp-driver && \
    cd /tmp/cpp-driver && \
    mkdir build && cd build && \
    cmake .. && \
    make && \
    make install && \
    cd / && rm -rf /tmp/cpp-driver && \
    # Update library cache after installation
    ldconfig
WORKDIR /opt/raiko
ENV DEBIAN_FRONTEND=noninteractive
ARG BUILD_FLAGS=""

FROM chef AS planner
COPY . .
COPY docker/cargo-config.toml .cargo/config.toml
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
# Ensure library paths are available for linking
RUN ldconfig
COPY --from=planner /opt/raiko/recipe.json recipe.json
RUN cargo chef cook --release ${BUILD_FLAGS} --features "sgx" --features "docker_build" --recipe-path recipe.json
COPY . .
COPY docker/cargo-config.toml .cargo/config.toml
RUN mkdir -p /etc/raiko && \
    cp dev.genesis.json /etc/raiko/dev.genesis.json
RUN cargo build --release ${BUILD_FLAGS} --features "sgx" --features "docker_build"

